generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String?
  password       String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  ownedCampaigns Campaign[]       @relation("CampaignOwner")
  memberships    CampaignMember[]
  characters     Character[]
  monsters       Monster[]
  journalEntries JournalEntry[]
}

model Campaign {
  id         String           @id @default(cuid())
  name       String
  ownerId    String
  owner      User             @relation("CampaignOwner", fields: [ownerId], references: [id])
  members    CampaignMember[]
  characters Character[]
  journals   JournalEntry[]
  invitations Invitation[]
  monsters    Monster[]
  combats    Combat[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model CampaignMember {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  role       Role
  canInvite         Boolean @default(false)
  canManageJournal  Boolean @default(false)
  canManageCombat   Boolean @default(false)
  canManageCharacters Boolean @default(false)
  canManageMonsters   Boolean @default(false)
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([campaignId, userId])
}

model Character {
  id         String   @id @default(cuid())
  campaignId String
  ownerId    String
  name       String
  dataJson   Json
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  owner      User     @relation(fields: [ownerId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model JournalEntry {
  id          String   @id @default(cuid())
  campaignId  String
  authorId    String
  title       String
  content     String
  tags        String[]
  attachments Json?
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invitation {
  id          String   @id @default(cuid())
  campaignId  String
  email       String?
  token       String   @unique
  role        Role     @default(PLAYER)
  acceptedBy  String?
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  campaign    Campaign @relation(fields: [campaignId], references: [id])
}

model Monster {
  id         String   @id @default(cuid())
  name       String
  dataJson   Json
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id])
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Combat {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  name        String
  isActive    Boolean  @default(false)
  currentTurn Int      @default(0)
  round       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  participants CombatParticipant[]
}

model CombatParticipant {
  id        String   @id @default(cuid())
  combatId  String
  combat    Combat   @relation(fields: [combatId], references: [id])
  name      String
  type      String   // 'character', 'monster', 'npc'
  entityId  String?  // ID del character/monster
  initiative Int
  hp        Int?
  maxHp     Int?
  ac        Int?
  conditions Json    @default("[]")
  isActive  Boolean  @default(true)
  order     Int
}

enum Role {
  DM
  PLAYER
}
